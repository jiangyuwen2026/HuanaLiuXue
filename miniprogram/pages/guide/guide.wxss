/* 申请指导页样式 */
.container {
  padding-bottom: 120rpx;
}

/* 通用区块 */
.section {
  margin: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 流程步骤 */
.process-steps {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
}

.step-number {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
  padding-top: 8rpx;
}

.step-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 时间线 */
.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  padding-left: 30rpx;
  position: relative;
  margin-bottom: 32rpx;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 24rpx;
  bottom: -8rpx;
  width: 2rpx;
  background-color: #e8e8e8;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background-color: #1890ff;
}

.timeline-content {
  padding-left: 20rpx;
}

.timeline-month {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1890ff;
  margin-bottom: 8rpx;
}

.timeline-event {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 材料清单 */
.material-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.material-item {
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
}

.material-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.material-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.material-status {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.material-status.required {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.material-status.optional {
  background-color: #f6ffed;
  color: #52c41a;
}

.material-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 常见问题 */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.faq-item {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.faq-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.faq-question {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.faq-answer {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  padding-left: 20rpx;
}

/* 底部操作 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.action-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background-color: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: none;
}
