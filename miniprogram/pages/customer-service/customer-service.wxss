/* 智能客服页面样式 */
.customer-service-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 100;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 20rpx;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.status {
  font-size: 22rpx;
  display: flex;
  align-items: center;
}

.status::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.status.online::before {
  background: #52c41a;
}

.status.offline::before {
  background: #ff4d4f;
}

/* 对话区域 */
.chat-area {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.message {
  margin-bottom: 40rpx;
}

.message-content {
  display: flex;
  align-items: flex-start;
  max-width: 80%;
}

.message.robot .message-content {
  justify-content: flex-start;
}

.message.user .message-content {
  flex-direction: row-reverse;
  margin-left: auto;
}

.message.human .message-content {
  justify-content: flex-start;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e8e8e8;
}

.message.robot .avatar {
  margin-right: 20rpx;
}

.message.user .avatar {
  margin-left: 20rpx;
}

.message.human .avatar {
  margin-right: 20rpx;
  border: 3rpx solid #faad14;
}

.bubble {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.message.robot .bubble,
.message.human .bubble {
  background: #ffffff;
  border-top-left-radius: 4rpx;
}

.message.user .bubble {
  background: #1890ff;
  color: #ffffff;
  border-top-right-radius: 4rpx;
}

.text {
  font-size: 28rpx;
  line-height: 1.6;
  word-wrap: break-word;
  white-space: pre-wrap;
}

.image {
  max-width: 400rpx;
  border-radius: 12rpx;
  display: block;
}

.time {
  font-size: 20rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
  text-align: right;
}

.message.user .time {
  color: rgba(255, 255, 255, 0.8);
}

/* 快捷回复 */
.quick-replies {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-reply-item {
  background: #f0f0f0;
  color: #666;
  padding: 16rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  transition: all 0.3s;
}

.quick-reply-item:active {
  background: #e0e0e0;
  transform: scale(0.95);
}

.message.welcome .quick-replies {
  margin-top: 0;
}

/* 转人工 */
.transfer-human {
  margin-top: 20rpx;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #faad14 0%, #fa8c16 100%);
  color: #ffffff;
  border-radius: 30rpx;
  font-size: 26rpx;
  text-align: center;
  font-weight: 500;
}

/* 加载中 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #ccc;
  border-radius: 50%;
  animation: typing 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
  }
  30% {
    transform: translateY(-10rpx);
  }
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-top: 1rpx solid #e8e8e8;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.function-btns {
  display: flex;
  gap: 16rpx;
  margin-right: 20rpx;
}

.function-btn {
  width: 60rpx;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.function-btn:active {
  background: #e8e8e8;
}

.input {
  flex: 1;
  height: 70rpx;
  background: #f5f5f5;
  border-radius: 35rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 70rpx;
  background: #e8e8e8;
  color: #999;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-left: 20rpx;
  transition: all 0.3s;
}

.send-btn.active {
  background: #1890ff;
  color: #ffffff;
}

.send-btn:active {
  transform: scale(0.95);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal {
  width: 560rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 20rpx 30rpx 40rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
  text-align: center;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #e8e8e8;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  font-size: 28rpx;
  transition: all 0.3s;
}

.modal-btn:active {
  background: #f5f5f5;
}

.modal-btn.cancel {
  color: #666;
  border-right: 1rpx solid #e8e8e8;
}

.modal-btn.confirm {
  color: #1890ff;
  font-weight: 500;
}
