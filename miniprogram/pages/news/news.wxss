/* 资讯列表页样式 */
page {
  background-color: #e8f4ff;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* ==================== 搜索头部 ==================== */
.search-header {
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  padding: var(--spacing-lg);
  padding-top: var(--spacing-xl);
  padding-bottom: 0;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-md);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-bg-primary);
  border-radius: var(--radius-full);
  padding: 0 var(--spacing-lg);
  height: 88rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon-placeholder {
  font-size: 32rpx;
  margin-right: var(--spacing-sm);
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.search-placeholder {
  color: var(--color-text-quaternary);
}

.search-btn {
  font-size: 28rpx;
  color: var(--color-text-white);
  font-weight: 500;
  padding: var(--spacing-sm) var(--spacing-md);
}

/* 筛选器 */
.filter-scroll {
  white-space: nowrap;
  padding: var(--spacing-md) 0;
  margin: 0 calc(-1 * var(--spacing-lg));
  padding-left: var(--spacing-lg);
  padding-right: var(--spacing-lg);
}

.filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 32rpx;
  margin-right: var(--spacing-md);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  color: var(--color-text-white);
  background: rgba(255, 255, 255, 0.2);
  transition: all var(--duration-normal) var(--ease-out);
  font-weight: 500;
  backdrop-filter: blur(10rpx);
}

.filter-item.active {
  color: var(--color-primary);
  background: var(--color-bg-primary);
  box-shadow: var(--shadow-sm);
}

/* ==================== 内容区域 ==================== */
.content-wrapper {
  padding: var(--spacing-lg);
}

/* ==================== 资讯列表 ==================== */
.news-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.news-item {
  display: flex;
  background: var(--color-bg-primary);
  border-radius: var(--radius-xl);
  overflow: hidden;
  padding: 0;
  box-shadow: var(--shadow-card);
  transition: all var(--duration-normal) var(--ease-out);
}

.news-item:active {
  transform: scale(0.98);
}

.news-cover {
  width: 220rpx;
  height: 180rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.news-content {
  flex: 1;
  padding: var(--spacing-md);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.news-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.news-summary {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-xs);
}

.news-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--spacing-sm);
}

.news-tag {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
}

.news-date {
  font-size: 22rpx;
  color: var(--color-text-quaternary);
}

/* ==================== 空状态 ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx var(--spacing-2xl);
}

.empty-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-secondary);
  border-radius: 50%;
  margin-bottom: var(--spacing-lg);
}

.empty-icon-text {
  font-size: 80rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  margin-bottom: var(--spacing-sm);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 加载状态 ==================== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-2xl);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--spacing-md);
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

/* ==================== 浮动按钮 ==================== */
.fab {
  position: fixed;
  right: var(--spacing-lg);
  bottom: calc(var(--spacing-2xl) + env(safe-area-inset-bottom));
  z-index: 100;
}

.fab-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
  border-radius: 50%;
  box-shadow: var(--shadow-float);
  transition: all var(--duration-normal) var(--ease-out);
}

.fab-button:active {
  transform: scale(0.9);
}

.fab-icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) invert(1);
}

.fab-text {
  font-size: 20rpx;
  color: var(--color-text-white);
  font-weight: 500;
  margin-top: 2rpx;
}
