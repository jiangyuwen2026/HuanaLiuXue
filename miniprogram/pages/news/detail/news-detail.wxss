/* 资讯详情页样式 */
.container {
  padding-bottom: 120rpx;
  background-color: #fff;
}

/* 文章头图 */
.article-cover {
  width: 100%;
  height: 400rpx;
}

/* 文章信息 */
.article-info {
  padding: 30rpx;
}

.article-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.meta-tag {
  padding: 4rpx 12rpx;
  background-color: #e6f7ff;
  color: #1890ff;
  font-size: 22rpx;
  border-radius: 4rpx;
}

.meta-time,
.meta-views {
  font-size: 24rpx;
  color: #999;
}

/* 文章内容 */
.article-content {
  padding: 0 30rpx 40rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}

/* 相关推荐 */
.related-section {
  padding: 0 30rpx 40rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.related-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.related-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-time {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

.consult-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background-color: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: none;
  margin-left: auto;
}
