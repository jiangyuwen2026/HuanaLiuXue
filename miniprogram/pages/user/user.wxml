<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-header">
      <block wx:if="{{isLoggedIn}}">
        <view class="user-info-wrapper">
          <image class="user-avatar" src="{{userInfo.avatar || '/images/tab/user.png'}}" mode="aspectFill" />
          <view class="user-meta">
            <text class="user-name">{{userInfo.nickname || '微信用户'}}</text>
            <view class="phone-wrapper" wx:if="{{userInfo.phone}}">
              <text class="user-phone">{{userInfo.phone}}</text>
              <text class="phone-tag">已绑定</text>
            </view>
            <block wx:else>
              <button class="bind-phone-btn" open-type="getPhoneNumber" bind:getphonenumber="getPhoneNumber">
                绑定手机号
              </button>
            </block>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="user-info-wrapper">
          <image class="user-avatar" src="/images/tab/user.png" mode="aspectFill" />
          <view class="user-meta">
            <button class="login-btn" bindtap="handleLogin" loading="{{isLogging}}">
              点击登录
            </button>
            <text class="login-tip">登录后可享受更多服务</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 快捷统计 -->
    <view class="stats-bar">
      <view class="stats-item" bindtap="goToFavorites">
        <text class="stats-num">{{stats.favorites}}</text>
        <text class="stats-label">我的收藏</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item" bindtap="goToAppointments">
        <text class="stats-num">{{stats.appointments}}</text>
        <text class="stats-label">我的预约</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item" bindtap="goToHistory">
        <text class="stats-num">{{stats.consults}}</text>
        <text class="stats-label">浏览历史</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="section-title">我的服务</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToAppointments">
        <view class="menu-left">
          <view class="menu-icon appointment">📅</view>
          <text class="menu-name">我的预约</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToFavorites">
        <view class="menu-left">
          <view class="menu-icon favorite">⭐</view>
          <text class="menu-name">我的收藏</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToHistory">
        <view class="menu-left">
          <view class="menu-icon history">📜</view>
          <text class="menu-name">浏览历史</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 更多服务 -->
  <view class="menu-section">
    <view class="section-title">更多服务</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="contactService">
        <view class="menu-left">
          <view class="menu-icon contact">📞</view>
          <text class="menu-name">联系客服</text>
        </view>
        <view class="menu-right">
          <text class="menu-extra">400-888-8888</text>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <view class="menu-left">
          <view class="menu-icon about">ℹ️</view>
          <text class="menu-name">关于我们</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view wx:if="{{isLoggedIn}}" class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">华南留学 v1.0.0</view>
</view>
