<!-- 成功案例列表页 -->
<view class="page-container">
  <!-- 筛选器 -->
  <view class="filter-header">
    <view class="filter-section">
      <view class="filter-row">
        <text class="filter-label">国家/地区</text>
        <scroll-view class="filter-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
          <view class="filter-item {{selectedCountry === '' ? 'active' : ''}}" 
                bindtap="onFilterCountry" data-country="">
            全部
          </view>
          <view class="filter-item {{selectedCountry === '香港' ? 'active' : ''}}" 
                bindtap="onFilterCountry" data-country="香港">
            香港
          </view>
          <view class="filter-item {{selectedCountry === '新加坡' ? 'active' : ''}}" 
                bindtap="onFilterCountry" data-country="新加坡">
            新加坡
          </view>
          <view class="filter-item {{selectedCountry === '英国' ? 'active' : ''}}" 
                bindtap="onFilterCountry" data-country="英国">
            英国
          </view>
          <view class="filter-item {{selectedCountry === '马来西亚' ? 'active' : ''}}" 
                bindtap="onFilterCountry" data-country="马来西亚">
            马来西亚
          </view>
        </scroll-view>
      </view>
      <view class="filter-row">
        <text class="filter-label">学位类型</text>
        <scroll-view class="filter-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
          <view class="filter-item {{selectedDegree === '' ? 'active' : ''}}" 
                bindtap="onFilterDegree" data-degree="">
            全部
          </view>
          <view class="filter-item {{selectedDegree === '本科' ? 'active' : ''}}" 
                bindtap="onFilterDegree" data-degree="本科">
            本科
          </view>
          <view class="filter-item {{selectedDegree === '硕士' ? 'active' : ''}}" 
                bindtap="onFilterDegree" data-degree="硕士">
            硕士
          </view>
          <view class="filter-item {{selectedDegree === '博士' ? 'active' : ''}}" 
                bindtap="onFilterDegree" data-degree="博士">
            博士
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 案例列表 -->
  <view class="content-wrapper">
    <view class="case-list" wx:if="{{caseList.length > 0}}">
      <view class="case-item card" 
            wx:for="{{caseList}}" 
            wx:key="id" 
            bindtap="goToDetail" 
            data-id="{{item.id}}">
        <!-- 案例头部 -->
        <view class="case-header">
          <view class="student-info">
            <view class="student-avatar">
              <text>{{item.studentName[0]}}</text>
            </view>
            <view class="student-detail">
              <text class="student-name">{{item.studentName}}</text>
              <text class="student-degree tag tag-primary">{{item.degree}}</text>
            </view>
          </view>
          <view class="case-result tag tag-success">
            <text>{{item.result}}</text>
          </view>
        </view>

        <!-- 案例详情 -->
        <view class="case-body">
          <view class="case-info-grid">
            <view class="case-info-item">
              <text class="info-icon">🎓</text>
              <view class="info-content">
                <text class="info-label">背景院校</text>
                <text class="info-value">{{item.background}}</text>
              </view>
            </view>
            <view class="case-info-item">
              <text class="info-icon">📚</text>
              <view class="info-content">
                <text class="info-label">申请专业</text>
                <text class="info-value">{{item.major}}</text>
              </view>
            </view>
            <view class="case-info-item">
              <text class="info-icon">📊</text>
              <view class="info-content">
                <text class="info-label">GPA/成绩</text>
                <text class="info-value">{{item.gpa}}</text>
              </view>
            </view>
            <view class="case-info-item">
              <text class="info-icon">🌐</text>
              <view class="info-content">
                <text class="info-label">语言成绩</text>
                <text class="info-value">{{item.language}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 录取结果 -->
        <view class="case-footer">
          <view class="offer-info">
            <text class="offer-label">录取院校</text>
            <text class="offer-value">{{item.offerSchool}}</text>
          </view>
          <view class="arrow-icon">
            <text>›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{caseList.length === 0 && !loading}}">
      <view class="empty-icon-wrapper">
        <text class="empty-icon-text">📋</text>
      </view>
      <text class="empty-title">暂无相关案例</text>
      <text class="empty-desc">调整筛选条件试试看</text>
    </view>

    <!-- 加载状态 -->
    <view class="loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>

<!-- 浮动咨询按钮 -->
<view class="fab" bindtap="navigateTo" data-path="/pages/appointment/appointment">
  <view class="fab-button">
    <image class="fab-icon" src="/images/icon/consult2.png" mode="aspectFit"></image>
    <text class="fab-text">咨询</text>
  </view>
</view>
