/* 专业详情页样式 */
.container {
  padding-bottom: 120rpx;
}

/* 专业信息 */
.major-info {
  margin: 30rpx;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.major-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.major-category {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
}

.major-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 通用区块 */
.section {
  margin: 0 30rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #666;
}

/* 课程列表 */
.course-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.course-item {
  padding: 12rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

/* 学校列表 */
.school-list {
  display: flex;
  flex-direction: column;
}

.school-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.school-item:last-child {
  border-bottom: none;
}

.school-name {
  font-size: 28rpx;
  color: #333;
}

.school-arrow {
  font-size: 24rpx;
  color: #ccc;
}

/* 就业方向 */
.career-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.career-item {
  padding: 12rpx 20rpx;
  background-color: #e6f7ff;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #1890ff;
}

/* 录取要求 */
.requirement-item {
  margin-bottom: 16rpx;
}

.req-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.req-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  padding-left: 20rpx;
}

/* 底部操作 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: none;
}
