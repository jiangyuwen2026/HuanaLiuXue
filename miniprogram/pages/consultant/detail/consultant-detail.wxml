<!-- 顾问详情页 -->
<view class="container">
  <!-- 顾问头部 -->
  <view class="consultant-header">
    <image class="header-bg" src="/images/bg/consultant-bg.png" mode="aspectFill"></image>
    <view class="header-content">
      <view class="avatar-wrapper">
        <image class="consultant-avatar" src="{{consultant.avatar}}" mode="aspectFill"></image>
        <text class="consultant-badge" wx:if="{{consultant.isSenior}}">资深顾问</text>
      </view>
      <text class="consultant-name">{{consultant.name}}</text>
      <text class="consultant-title">{{consultant.title}}</text>
      <view class="consultant-stats">
        <view class="stat-item">
          <text class="stat-value">{{consultant.experience}}</text>
          <text class="stat-label">从业经验</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{consultant.caseCount}}+</text>
          <text class="stat-label">成功案例</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{consultant.successRate}}%</text>
          <text class="stat-label">录取率</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 顾问简介 -->
  <view class="section card">
    <view class="section-title">顾问简介</view>
    <text class="section-content">{{consultant.introduction}}</text>
  </view>

  <!-- 专长领域 -->
  <view class="section card">
    <view class="section-title">专长领域</view>
    <view class="expertise-list">
      <text class="expertise-item tag tag-primary" wx:for="{{consultant.expertise}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 服务项目 -->
  <view class="section card">
    <view class="section-title">服务项目</view>
    <view class="service-list">
      <view class="service-item" wx:for="{{consultant.services}}" wx:key="*this">
        <text class="service-name">{{item}}</text>
        <text class="service-check">✓</text>
      </view>
    </view>
  </view>

  <!-- 工作时间 -->
  <view class="section card">
    <view class="section-title">可预约时间</view>
    <view class="schedule-list">
      <view class="schedule-item" wx:for="{{consultant.schedule}}" wx:key="day">
        <text class="schedule-day">{{item.day}}</text>
        <text class="schedule-time">{{item.time}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <button class="action-btn btn-outline" open-type="contact" session-from="consultant">
      在线咨询
    </button>
    <button class="action-btn" bindtap="makeAppointment">预约面谈</button>
  </view>
</view>
