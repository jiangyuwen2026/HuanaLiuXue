/* 学校列表页样式 */
page {
  background-color: #e8f4ff;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* ==================== 搜索头部 ==================== */
.search-header {
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  padding: var(--spacing-lg);
  padding-top: var(--spacing-xl);
}

/* 搜索标签页 */
.search-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
  padding: 4rpx;
  backdrop-filter: blur(10px);
}

.search-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: var(--radius-full);
  transition: all var(--duration-normal) var(--ease-out);
  position: relative;
}

.search-tab.active {
  background: var(--color-text-white);
}

.tab-text {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.8);
  transition: color var(--duration-normal);
  position: relative;
  z-index: 1;
}

.search-tab.active .tab-text {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 4rpx;
  width: 24rpx;
  height: 3rpx;
  background: var(--color-accent);
  border-radius: 2rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-bg-primary);
  border-radius: var(--radius-full);
  padding: 0 var(--spacing-lg);
  height: 88rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon-placeholder {
  font-size: 32rpx;
  margin-right: var(--spacing-sm);
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.search-placeholder {
  color: var(--color-text-quaternary);
}

.search-btn {
  font-size: 28rpx;
  color: var(--color-text-white);
  font-weight: 500;
  padding: var(--spacing-sm) var(--spacing-md);
}

/* ==================== 筛选器 ==================== */
.filter-container {
  background: var(--color-bg-primary);
  padding: var(--spacing-md) var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border-light);
}

.filter-scroll {
  white-space: nowrap;
  margin: 0 calc(-1 * var(--spacing-lg));
  padding: 0 var(--spacing-lg);
}

.filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  margin-right: var(--spacing-md);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-secondary);
  transition: all var(--duration-normal) var(--ease-out);
  font-weight: 500;
}

.filter-item:last-child {
  margin-right: 0;
}

.filter-item.active {
  color: var(--color-text-white);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.25);
}

/* ==================== 内容区域 ==================== */
.content-wrapper {
  padding: var(--spacing-lg);
}

/* ==================== 学校列表 ==================== */
.school-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.school-item {
  background: var(--color-bg-primary);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-normal) var(--ease-out);
  position: relative;
  overflow: hidden;
}

.school-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  opacity: 0;
  transition: opacity var(--duration-normal);
}

.school-item:active {
  transform: scale(0.98);
}

.school-item:active::before {
  opacity: 1;
}

/* 学校头部 */
.school-header {
  margin-bottom: var(--spacing-md);
}

.school-name-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-sm);
}

.school-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
  margin-right: var(--spacing-md);
}

.school-ranking {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, rgba(201, 169, 98, 0.15) 0%, rgba(201, 169, 98, 0.08) 100%);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.ranking-label {
  font-size: 20rpx;
  color: var(--color-accent-dark);
}

.ranking-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-accent-dark);
}

.school-badges {
  display: flex;
  gap: var(--spacing-sm);
}

.badge-country {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
}

.badge-type {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
}

/* 学校信息 */
.school-info {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
}

.info-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.info-icon {
  font-size: 24rpx;
}

.info-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* 学校标签 */
.school-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.school-tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background: rgba(30, 58, 95, 0.06);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(30, 58, 95, 0.1);
}

/* 学校底部 */
.school-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--color-border-light);
}

.major-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
  margin-right: var(--spacing-md);
}

.major-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.major-value {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.arrow-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-secondary);
  border-radius: 50%;
  flex-shrink: 0;
}

.arrow-icon text {
  font-size: 32rpx;
  color: var(--color-text-quaternary);
}

/* ==================== 专业搜索结果 ==================== */
.major-results-section {
  padding: var(--spacing-lg);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-border-light);
}

.results-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.results-count {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-secondary);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
}

.major-results-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.major-result-item {
  background: var(--color-bg-primary);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-normal) var(--ease-out);
  border-left: 4rpx solid var(--color-accent);
}

.major-result-item:active {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-hover);
}

/* 专业匹配区域 */
.major-match-section {
  margin: var(--spacing-md) 0;
}

.match-count-badge {
  margin-bottom: var(--spacing-md);
}

.match-count {
  display: inline-block;
  font-size: 24rpx;
  color: var(--color-accent);
  background: rgba(201, 169, 98, 0.1);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
}

.match-group {
  display: flex;
  align-items: flex-start;
  margin-bottom: var(--spacing-sm);
}

.match-group-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  width: 100rpx;
  flex-shrink: 0;
  padding-top: 6rpx;
}

.match-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.match-tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background: rgba(30, 58, 95, 0.08);
  padding: 8rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(30, 58, 95, 0.15);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 200rpx;
}

.match-more {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  padding: 8rpx 12rpx;
}

/* 专业结果底部 */
.major-result-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--color-border-light);
  margin-top: var(--spacing-sm);
}

.view-detail-text {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* ==================== 空状态 ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx var(--spacing-2xl);
}

.empty-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-secondary);
  border-radius: 50%;
  margin-bottom: var(--spacing-lg);
}

.empty-icon-text {
  font-size: 80rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  margin-bottom: var(--spacing-sm);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 加载状态 ==================== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-2xl);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--spacing-md);
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

/* ==================== 浮动按钮 ==================== */
.fab {
  position: fixed;
  right: var(--spacing-lg);
  bottom: calc(var(--spacing-2xl) + env(safe-area-inset-bottom));
  z-index: 100;
}

.fab-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
  border-radius: 50%;
  box-shadow: var(--shadow-float);
  transition: all var(--duration-normal) var(--ease-out);
}

.fab-button:active {
  transform: scale(0.9);
}

.fab-icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) invert(1);
}

.fab-text {
  font-size: 20rpx;
  color: var(--color-text-white);
  font-weight: 500;
  margin-top: 2rpx;
}
