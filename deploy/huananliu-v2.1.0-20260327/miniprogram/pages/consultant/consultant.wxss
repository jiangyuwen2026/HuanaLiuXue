/* 顾问团队页样式 */
page {
  background-color: #e8f4ff;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* ==================== 搜索头部 ==================== */
.search-header {
  background: linear-gradient(180deg, #1E3A5F 0%, #2D5A9F 100%);
  padding: 40rpx 32rpx 0;
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(30, 58, 95, 0.25);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-md);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  border-radius: 100rpx;
  padding: 0 32rpx;
  height: 96rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.search-input-wrapper:focus-within {
  background: rgba(255, 255, 255, 0.25);
  border-color: rgba(255, 255, 255, 0.4);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.2);
}

.search-icon-placeholder {
  font-size: 32rpx;
  margin-right: var(--spacing-sm);
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.search-placeholder {
  color: var(--color-text-quaternary);
}

.search-btn {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.search-btn:hover {
  background: rgba(255, 255, 255, 0.3);
  border-color: rgba(255, 255, 255, 0.5);
  transform: translateY(-2rpx);
}

/* 专长筛选 */
.expertise-scroll {
  white-space: nowrap;
  padding: var(--spacing-md) 0;
  margin: 0 calc(-1 * var(--spacing-lg));
  padding-left: var(--spacing-lg);
  padding-right: var(--spacing-lg);
}

.expertise-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 36rpx;
  margin-right: 20rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.15);
  transition: all 0.3s ease;
  font-weight: 500;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.expertise-item.active {
  color: #1E3A5F;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
  border-color: transparent;
  font-weight: 600;
}

/* ==================== 内容区域 ==================== */
.content-wrapper {
  padding: var(--spacing-lg);
}

/* ==================== 顾问列表 ==================== */
.consultant-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.consultant-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(30, 58, 95, 0.08);
  display: flex;
  gap: 28rpx;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border: 2rpx solid transparent;
}

.consultant-item:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 40rpx rgba(30, 58, 95, 0.12);
  border-color: rgba(30, 58, 95, 0.1);
}

.consultant-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  opacity: 0;
  transition: opacity var(--duration-normal);
}

.consultant-item:active {
  transform: scale(0.98);
}

.consultant-item:active::before {
  opacity: 1;
}

/* 顾问头像 */
.consultant-avatar-wrapper {
  position: relative;
  flex-shrink: 0;
}

.consultant-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.15);
}

.senior-badge {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
  color: var(--color-text-white);
  font-size: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
  box-shadow: var(--shadow-sm);
  white-space: nowrap;
}

/* 顾问信息 */
.consultant-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.consultant-header {
  margin-bottom: var(--spacing-md);
}

.name-row {
  display: flex;
  align-items: baseline;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.consultant-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.consultant-title {
  font-size: 22rpx;
  font-weight: 500;
}

.stats-row {
  display: flex;
  align-items: center;
  background: rgba(30, 58, 95, 0.05);
  border-radius: 14rpx;
  padding: 16rpx 24rpx;
  border: 2rpx solid rgba(30, 58, 95, 0.08);
  backdrop-filter: blur(10rpx);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E3A5F;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.stat-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--color-border-light);
}

/* 擅长领域 */
.consultant-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.consultant-tag {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
  background: linear-gradient(135deg, #1E3A5F 0%, #2D5A9F 100%);
  padding: 10rpx 20rpx;
  border-radius: 100rpx;
  box-shadow: 0 4rpx 8rpx rgba(30, 58, 95, 0.15);
}

/* 操作按钮 */
.consultant-footer {
  display: flex;
  gap: var(--spacing-md);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--color-border-light);
}

.consult-btn {
  flex: 1;
  background: linear-gradient(135deg, #1E3A5F 0%, #3D7AD9 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border-radius: 14rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(30, 58, 95, 0.25);
  transition: all 0.3s ease;
}

.consult-btn:hover {
  background: linear-gradient(135deg, #2D5A9F 0%, #4A8AF5 100%);
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 20rpx rgba(30, 58, 95, 0.3);
}

.view-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1E3A5F;
  padding: 20rpx 0;
  border-radius: 14rpx;
  background: #fff;
  border: 2rpx solid rgba(30, 58, 95, 0.15);
  transition: all 0.3s ease;
}

.view-btn:hover {
  border-color: rgba(30, 58, 95, 0.25);
  background: rgba(30, 58, 95, 0.03);
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 95, 0.1);
}

.arrow-text {
  font-size: 30rpx;
  font-weight: 300;
}

/* ==================== 空状态 ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx var(--spacing-2xl);
}

.empty-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-secondary);
  border-radius: 50%;
  margin-bottom: var(--spacing-lg);
}

.empty-icon-text {
  font-size: 80rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  margin-bottom: var(--spacing-sm);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 加载状态 ==================== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-2xl);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--spacing-md);
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

/* ==================== 浮动按钮 ==================== */
.fab {
  position: fixed;
  right: var(--spacing-lg);
  bottom: calc(var(--spacing-2xl) + env(safe-area-inset-bottom));
  z-index: 100;
}

.fab-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
  border-radius: 50%;
  box-shadow: var(--shadow-float);
  transition: all var(--duration-normal) var(--ease-out);
}

.fab-button:active {
  transform: scale(0.9);
}

.fab-icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) invert(1);
}

.fab-text {
  font-size: 20rpx;
  color: var(--color-text-white);
  font-weight: 500;
  margin-top: 2rpx;
}
