/* 案例详情页样式 */
.container {
  padding-bottom: 120rpx;
}

/* 学生信息头部 */
.student-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin: 30rpx;
}

.student-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
}

.student-info {
  flex: 1;
}

.student-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.student-degree {
  display: inline-block;
}

.case-result {
  text-align: center;
}

.result-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.result-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

/* 通用区块 */
.section {
  margin: 0 30rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 录取院校 */
.offer-card {
  padding: 30rpx;
  background: linear-gradient(135deg, #f0f9ff, #e6f7ff);
  border-radius: 8rpx;
  text-align: center;
}

.offer-school {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1890ff;
  margin-bottom: 12rpx;
}

.offer-major {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.offer-tags {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.tag-success {
  background-color: #f6ffed;
  color: #52c41a;
}

.tag-primary {
  background-color: #e6f7ff;
  color: #1890ff;
}

/* 申请背景 */
.background-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bg-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.bg-item:last-child {
  border-bottom: none;
}

.bg-label {
  font-size: 26rpx;
  color: #666;
}

.bg-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 申请故事 */
.story-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #666;
}

/* 申请材料 */
.material-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.material-item {
  font-size: 28rpx;
  color: #52c41a;
  line-height: 1.6;
}

/* 顾问点评 */
.consultant-review {
  padding: 24rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
}

.reviewer-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.reviewer-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.reviewer-details {
  flex: 1;
}

.reviewer-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.reviewer-title {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.review-content {
  font-size: 26rpx;
  line-height: 1.8;
  color: #666;
}

/* 底部操作 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: none;
}
