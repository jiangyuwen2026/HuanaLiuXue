<!-- 资讯详情页 -->
<view class="container">
  <!-- 文章头图 -->
  <image class="article-cover" src="{{article.coverImage}}" mode="aspectFill"></image>

  <!-- 文章信息 -->
  <view class="article-info">
    <text class="article-title">{{article.title}}</text>
    <view class="article-meta">
      <text class="meta-tag">{{article.country}}</text>
      <text class="meta-time">{{article.publishTime}}</text>
      <text class="meta-views">{{article.views}} 阅读</text>
    </view>
  </view>

  <!-- 文章内容 -->
  <view class="article-content">
    <rich-text nodes="{{article.content}}"></rich-text>
  </view>

  <!-- 相关推荐 -->
  <view class="related-section" wx:if="{{relatedArticles.length > 0}}">
    <view class="section-title">相关推荐</view>
    <view class="related-item" wx:for="{{relatedArticles}}" wx:key="id" bindtap="goToRelated" data-id="{{item.id}}">
      <text class="related-title">{{item.title}}</text>
      <text class="related-time">{{item.publishTime}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="action-item" bindtap="toggleCollect">
      <image class="action-icon" src="{{article.isCollected ? '/images/icon/collected.png' : '/images/icon/collect.png'}}" mode="aspectFit"></image>
      <text class="action-text">{{article.isCollected ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="action-item" bindtap="onShare">
      <image class="action-icon" src="/images/icon/share.png" mode="aspectFit"></image>
      <text class="action-text">分享</text>
    </view>
    <button class="consult-btn" open-type="contact" session-from="article">立即咨询</button>
  </view>
</view>
