<view class="container">
  <view class="empty-state" wx:if="{{history.length === 0}}">
    <text class="empty-text">暂无浏览记录</text>
  </view>
  
  <view class="history-list" wx:else>
    <view class="history-item" wx:for="{{history}}" wx:key="id" bindtap="goToDetail" data-url="{{item.url}}">
      <text>{{item.title}}</text>
      <text class="history-time">{{item.time}}</text>
    </view>
    <button class="clear-btn" bindtap="clearHistory">清空记录</button>
  </view>
</view>
