/* 咨询预约页样式 */
page {
  background-color: #e8f4ff;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* ==================== 专业头部 ==================== */
.page-header {
  position: relative;
  height: 380rpx;
  overflow: hidden;
}

.header-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.header-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(30, 58, 95, 0.85) 0%, rgba(42, 82, 152, 0.75) 50%, rgba(201, 169, 98, 0.7) 100%);
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 80rpx var(--spacing-xl) 40rpx;
}

.header-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 400;
  margin-bottom: 24rpx;
}

.header-tags {
  display: flex;
  gap: 20rpx;
}

.header-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 18rpx;
  border-radius: var(--radius-full);
  backdrop-filter: blur(10rpx);
}

.header-tag image {
  width: 24rpx;
  height: 24rpx;
}

.header-tag text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
}

/* ==================== 页面内容 ==================== */
.page-content {
  margin-top: -80rpx;
  padding: 0 24rpx;
  position: relative;
  z-index: 2;
}

.bottom-placeholder {
  height: 160rpx;
}

/* ==================== 区块卡片 ==================== */
.section-card {
  background: var(--color-bg-primary);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 58, 95, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(30, 58, 95, 0.1) 0%, rgba(201, 169, 98, 0.1) 100%);
  border-radius: 12rpx;
  margin-right: 14rpx;
}

.header-icon image {
  width: 28rpx;
  height: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.section-required {
  color: var(--color-danger);
  margin-left: 6rpx;
  font-size: 26rpx;
}

.sub-title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  margin-bottom: 20rpx;
  display: block;
}

/* ==================== 顾问选择 ==================== */
.consultant-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(30, 58, 95, 0.04) 0%, rgba(201, 169, 98, 0.04) 100%);
  border-radius: 16rpx;
  border: 2rpx solid var(--color-border-light);
  transition: all var(--duration-normal);
}

.consultant-selector:active {
  border-color: var(--color-primary);
  background: rgba(30, 58, 95, 0.06);
}

.selector-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.consultant-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid var(--color-accent);
  box-shadow: 0 4rpx 12rpx rgba(201, 169, 98, 0.2);
}

.consultant-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.consultant-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.consultant-title {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.consultant-hint {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.selector-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-primary);
  border-radius: 50%;
  box-shadow: var(--shadow-xs);
}

.selector-arrow text {
  font-size: 36rpx;
  color: var(--color-text-quaternary);
  font-weight: 300;
}

/* ==================== 咨询类型 ==================== */
.type-list {
  display: flex;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  padding: 24rpx 20rpx;
  background: var(--color-bg-secondary);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  position: relative;
  transition: all var(--duration-normal);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.type-item.active {
  border-color: var(--color-primary);
  background: linear-gradient(135deg, rgba(30, 58, 95, 0.06) 0%, rgba(201, 169, 98, 0.06) 100%);
}

.type-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(30, 58, 95, 0.08) 0%, rgba(201, 169, 98, 0.08) 100%);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.type-icon-wrap image {
  width: 36rpx;
  height: 36rpx;
}

.type-content {
  flex: 1;
  width: 100%;
}

.type-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.type-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.type-badge {
  font-size: 18rpx;
  padding: 3rpx 10rpx;
}

.type-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.type-duration {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

.type-desc {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.type-check {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  border-radius: 50%;
  color: var(--color-text-white);
  font-size: 24rpx;
  font-weight: 600;
}

/* ==================== 日期选择 ==================== */
.date-section {
  margin-bottom: 32rpx;
}

.date-scroll {
  white-space: nowrap;
  margin: 0 -16rpx;
  padding: 0 16rpx;
}

.date-list {
  display: inline-flex;
  gap: 20rpx;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  padding: 24rpx 16rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-xl);
  border: 3rpx solid transparent;
  transition: all var(--duration-normal);
  position: relative;
  overflow: hidden;
}

.date-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: transparent;
  transition: all var(--duration-normal);
}

.date-item.active {
  border-color: var(--color-primary);
  background: linear-gradient(180deg, rgba(30, 58, 95, 0.08) 0%, rgba(30, 58, 95, 0.02) 100%);
}

.date-item.active::before {
  background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-accent) 100%);
}

.date-month {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.date-item.active .date-month {
  color: var(--color-primary);
}

.date-day-wrap {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-primary);
  border-radius: 50%;
  margin-bottom: 12rpx;
  transition: all var(--duration-normal);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.date-item.active .date-day-wrap {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.3);
}

.date-day {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.date-item.active .date-day {
  color: var(--color-text-white);
}

.date-weekday {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.date-item.active .date-weekday {
  color: var(--color-primary);
  font-weight: 600;
}

.date-status {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 18rpx;
  color: var(--color-accent);
  font-weight: 600;
  background: rgba(201, 169, 98, 0.15);
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
}

/* ==================== 时间选择 ==================== */
.time-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.time-item {
  padding: 18rpx 12rpx;
  text-align: center;
  background: var(--color-bg-secondary);
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all var(--duration-normal);
  position: relative;
}

.time-item.active {
  border-color: var(--color-primary);
  background: rgba(30, 58, 95, 0.06);
}

.time-item.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.time-text {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.time-item.active .time-text {
  color: var(--color-primary);
}

.time-status {
  display: block;
  font-size: 20rpx;
  color: var(--color-danger);
  margin-top: 4rpx;
}

/* ==================== 咨询需求 ==================== */
.textarea-wrapper {
  position: relative;
}

.requirement-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background: var(--color-bg-secondary);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: var(--color-text-quaternary);
}

.char-count {
  position: absolute;
  right: 20rpx;
  bottom: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-quaternary);
}

/* ==================== 联系方式 ==================== */
.form-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-label-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.form-label-wrap image {
  width: 26rpx;
  height: 26rpx;
}

.form-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: var(--color-bg-secondary);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all var(--duration-normal);
}

.form-input:focus {
  border-color: var(--color-primary);
  background: rgba(30, 58, 95, 0.04);
}

.input-placeholder {
  color: var(--color-text-quaternary);
}

/* ==================== 底部操作栏 ==================== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-primary);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.bar-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.price-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.price-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.price-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-danger);
}

.price-free {
  color: var(--color-success);
}

.submit-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: var(--color-text-white);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-xl);
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(30, 58, 95, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}

.submit-btn.disabled {
  background: var(--color-border);
  box-shadow: none;
}

.submit-btn::after {
  border: none;
}
