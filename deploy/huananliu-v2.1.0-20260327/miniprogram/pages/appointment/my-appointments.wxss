/* 我的预约页样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 预约列表 */
.appointment-list {
  padding: 30rpx;
}

.appointment-item {
  margin-bottom: 20rpx;
}

.appointment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 16rpx;
}

.appointment-consultant {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.appointment-status {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.appointment-status.pending {
  background-color: #fff7e6;
  color: #faad14;
}

.appointment-status.confirmed {
  background-color: #e6f7ff;
  color: #1890ff;
}

.appointment-status.completed {
  background-color: #f6ffed;
  color: #52c41a;
}

.appointment-status.cancelled {
  background-color: #f5f5f5;
  color: #999;
}

.appointment-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  font-size: 26rpx;
}

.info-label {
  color: #999;
  flex-shrink: 0;
}

.info-value {
  color: #666;
  flex: 1;
}

.appointment-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: none;
}
