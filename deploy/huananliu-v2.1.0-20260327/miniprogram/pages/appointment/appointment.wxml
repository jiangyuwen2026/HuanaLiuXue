<!-- 在线咨询预约页 -->
<view class="page-container">
  <!-- 专业头部 -->
  <view class="page-header">
    <image class="header-image" src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=750x400&fit=crop" mode="aspectFill"></image>
    <view class="header-overlay"></view>
    <view class="header-content">
      <text class="header-title">立即预约</text>
      <text class="header-subtitle">专业顾问一对一为您规划留学之路</text>
      <view class="header-tags">
        <view class="header-tag">
          <image src="https://img.icons8.com/ios-filled/20/ffffff/verified.png" mode="aspectFit"></image>
          <text>官方认证</text>
        </view>
        <view class="header-tag">
          <image src="https://img.icons8.com/ios-filled/20/ffffff/shield.png" mode="aspectFit"></image>
          <text>隐私保护</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 页面内容 -->
  <view class="page-content">
    <!-- 选择顾问 -->
    <view class="section-card">
      <view class="section-header">
        <view class="header-icon">
          <image src="https://img.icons8.com/ios-filled/32/1E3A5F/user.png" mode="aspectFit"></image>
        </view>
        <text class="section-title">选择顾问</text>
        <text class="section-required">*</text>
      </view>
      <view class="consultant-selector" bindtap="selectConsultant">
        <view class="selector-content">
          <image class="consultant-avatar" 
                 src="{{selectedConsultant.avatar}}" 
                 mode="aspectFill">
          </image>
          <view class="consultant-info">
            <text class="consultant-name">{{selectedConsultant.name}}</text>
            <text class="consultant-title" wx:if="{{selectedConsultant.title}}">{{selectedConsultant.title}}</text>
            <text class="consultant-hint" wx:else>点击选择您想咨询的顾问</text>
          </view>
        </view>
        <view class="selector-arrow">
          <text>›</text>
        </view>
      </view>
    </view>

    <!-- 咨询类型 -->
    <view class="section-card">
      <view class="section-header">
        <view class="header-icon">
          <image src="https://img.icons8.com/ios-filled/32/1E3A5F/topic.png" mode="aspectFit"></image>
        </view>
        <text class="section-title">咨询类型</text>
        <text class="section-required">*</text>
      </view>
      <view class="type-list">
        <view class="type-item {{selectedType === 'free' ? 'active' : ''}}" 
              bindtap="onSelectType" data-type="free">
          <view class="type-icon-wrap">
            <image src="https://img.icons8.com/ios-filled/40/C9A962/chat.png" mode="aspectFit"></image>
          </view>
          <view class="type-content">
            <view class="type-header">
              <text class="type-name">免费咨询</text>
              <view class="type-badge tag tag-success">推荐</view>
            </view>
            <view class="type-info">
              <text class="type-duration">30分钟</text>
              <text class="type-desc">初步了解留学规划</text>
            </view>
          </view>
          <view class="type-check" wx:if="{{selectedType === 'free'}}">
            <text>✓</text>
          </view>
        </view>
        <view class="type-item {{selectedType === 'paid' ? 'active' : ''}}" 
              bindtap="onSelectType" data-type="paid">
          <view class="type-icon-wrap">
            <image src="https://img.icons8.com/ios-filled/40/1E3A5F/data-configuration.png" mode="aspectFit"></image>
          </view>
          <view class="type-content">
            <view class="type-header">
              <text class="type-name">深度咨询</text>
              <view class="type-badge tag tag-primary">专业</view>
            </view>
            <view class="type-info">
              <text class="type-duration">1小时</text>
              <text class="type-desc">一对一精准规划</text>
            </view>
          </view>
          <view class="type-check" wx:if="{{selectedType === 'paid'}}">
            <text>✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 预约时间 -->
    <view class="section-card">
      <view class="section-header">
        <view class="header-icon">
          <image src="https://img.icons8.com/ios-filled/32/1E3A5F/schedule.png" mode="aspectFit"></image>
        </view>
        <text class="section-title">预约时间</text>
        <text class="section-required">*</text>
      </view>
      <!-- 日期选择 -->
      <view class="date-section">
        <text class="sub-title">选择日期</text>
        <scroll-view class="date-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
          <view class="date-list">
            <view class="date-item {{selectedDate === item.date ? 'active' : ''}}"
                  wx:for="{{dateList}}"
                  wx:key="date"
                  bindtap="onSelectDate"
                  data-date="{{item.date}}">
              <view class="date-month">{{item.month}}月</view>
              <view class="date-day-wrap">
                <text class="date-day">{{item.day}}</text>
              </view>
              <view class="date-weekday">{{item.weekday}}</view>
              <view class="date-status" wx:if="{{selectedDate === item.date}}">✓</view>
            </view>
          </view>
        </scroll-view>
      </view>
      <!-- 时间选择 -->
      <view class="time-section">
        <text class="sub-title">选择时间段</text>
        <view class="time-grid">
          <view class="time-item {{selectedTime === item.time ? 'active' : ''}} {{!item.available ? 'disabled' : ''}}"
                wx:for="{{timeList}}"
                wx:key="time"
                bindtap="onSelectTime"
                data-time="{{item.time}}"
                data-available="{{item.available}}">
            <text class="time-text">{{item.time}}</text>
            <text class="time-status" wx:if="{{!item.available}}">已约满</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 咨询需求 -->
    <view class="section-card">
      <view class="section-header">
        <view class="header-icon">
          <image src="https://img.icons8.com/ios-filled/32/1E3A5F/edit.png" mode="aspectFit"></image>
        </view>
        <text class="section-title">咨询需求</text>
      </view>
      <view class="textarea-wrapper">
        <textarea class="requirement-input"
                  placeholder="请简要描述您的留学需求、目标国家、专业等..."
                  placeholder-class="textarea-placeholder"
                  value="{{requirement}}"
                  bindinput="onRequirementInput"
                  maxlength="500">
        </textarea>
        <text class="char-count">{{requirement.length}}/500</text>
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="section-card">
      <view class="section-header">
        <view class="header-icon">
          <image src="https://img.icons8.com/ios-filled/32/1E3A5F/phone.png" mode="aspectFit"></image>
        </view>
        <text class="section-title">联系方式</text>
        <text class="section-required">*</text>
      </view>
      <view class="form-list">
        <view class="form-item">
          <view class="form-label-wrap">
            <image src="https://img.icons8.com/ios-filled/24/1E3A5F/user.png" mode="aspectFit"></image>
            <text class="form-label">姓名</text>
          </view>
          <input class="form-input" 
                 placeholder="请输入您的姓名" 
                 placeholder-class="input-placeholder"
                 value="{{name}}" 
                 bindinput="onNameInput" />
        </view>
        <view class="form-item">
          <view class="form-label-wrap">
            <image src="https://img.icons8.com/ios-filled/24/1E3A5F/phone.png" mode="aspectFit"></image>
            <text class="form-label">手机号</text>
          </view>
          <input class="form-input" 
                 type="number" 
                 placeholder="请输入手机号" 
                 placeholder-class="input-placeholder"
                 value="{{phone}}" 
                 bindinput="onPhoneInput" />
        </view>
        <view class="form-item">
          <view class="form-label-wrap">
            <image src="https://img.icons8.com/ios-filled/24/1E3A5F/wechat.png" mode="aspectFit"></image>
            <text class="form-label">微信号</text>
          </view>
          <input class="form-input" 
                 placeholder="请输入微信号（可选）" 
                 placeholder-class="input-placeholder"
                 value="{{wechat}}" 
                 bindinput="onWechatInput" />
        </view>
      </view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>
</view>

<!-- 底部操作栏 -->
<view class="bottom-bar">
  <view class="bar-content">
    <view class="price-info" wx:if="{{selectedType === 'paid'}}">
      <text class="price-label">咨询费用</text>
      <text class="price-value">¥299</text>
    </view>
    <view class="price-info" wx:else>
      <text class="price-label">咨询费用</text>
      <text class="price-value price-free">免费</text>
    </view>
    <button class="submit-btn {{canSubmit ? '' : 'disabled'}}" 
            bindtap="submitAppointment" 
            disabled="{{submitting}}">
      <text wx:if="{{submitting}}">提交中...</text>
      <text wx:else>确认预约</text>
    </button>
  </view>
</view>
