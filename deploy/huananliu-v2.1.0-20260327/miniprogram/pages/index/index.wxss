/* 首页样式 */
page {
  background-color: #e8f4ff;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* ==================== 顶部区域 ==================== */
.header-section {
  position: relative;
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-light) 60%, var(--color-bg-secondary) 100%);
  padding-bottom: 80rpx;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 400rpx;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.3));
  pointer-events: none;
}

/* 功能入口 */
.function-section {
  position: relative;
  margin: -60rpx var(--spacing-lg) 0;
  background: var(--color-bg-primary);
  border-radius: var(--radius-xl);
  padding: 40rpx 32rpx;
  box-shadow: var(--shadow-lg);
}

.function-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(50% - 16rpx);
  padding: 32rpx 0;
  transition: transform var(--duration-normal) var(--ease-out);
}

.function-item:active {
  transform: scale(0.95);
}

.function-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(30, 58, 95, 0.06) 0%, rgba(201, 169, 98, 0.06) 100%);
  border-radius: var(--radius-xl);
  margin-bottom: 20rpx;
  transition: all var(--duration-normal);
}

.function-item:active .function-icon-wrapper {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
}

.function-icon {
  width: 64rpx;
  height: 64rpx;
  transition: transform var(--duration-normal);
}

.function-item:active .function-icon {
  transform: scale(0.9);
  filter: brightness(0) invert(1);
}

.function-name {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  text-align: center;
  line-height: 1.4;
}

/* ==================== 内容区域 ==================== */
.content-section {
  padding: var(--spacing-lg);
}

/* 区块 */
.section {
  margin-bottom: 60rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, rgba(30, 58, 95, 0.06) 0%, rgba(201, 169, 98, 0.06) 100%);
  border-radius: var(--radius-lg);
  border-left: 6rpx solid var(--color-primary);
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 1rpx;
}

.more-link {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  transition: color var(--duration-fast);
}

.more-link:active {
  color: var(--color-primary);
}

.more-arrow {
  margin-left: 4rpx;
  font-size: 32rpx;
  font-weight: 300;
}

/* ==================== 资讯列表 ==================== */
.news-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.news-item {
  display: flex;
  background: var(--color-bg-primary);
  border-radius: var(--radius-xl);
  overflow: hidden;
  padding: 0;
  box-shadow: var(--shadow-card);
  transition: all var(--duration-normal) var(--ease-out);
}

.news-item:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.news-cover {
  width: 220rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 0;
  margin-right: 20rpx;
}

.news-content {
  flex: 1;
  padding: var(--spacing-md);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.news-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.news-summary {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-xs);
}

.news-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--spacing-sm);
}

.news-tag {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
}

.news-date {
  font-size: 22rpx;
  color: var(--color-text-quaternary);
}

/* ==================== 案例列表 ==================== */
.case-scroll {
  white-space: nowrap;
  margin: 0 calc(-1 * var(--spacing-lg));
  padding: 0 var(--spacing-lg);
}

.case-item {
  display: inline-block;
  width: 340rpx;
  margin-right: var(--spacing-md);
  vertical-align: top;
}

.case-item:last-child {
  margin-right: 0;
}

.case-card {
  background: var(--color-bg-primary);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-normal) var(--ease-out);
}

.case-item:active .case-card {
  transform: scale(0.96);
  box-shadow: var(--shadow-sm);
}

.case-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-md);
  border-bottom: 1rpx solid var(--color-border-light);
}

.case-student {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.case-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}

.case-body {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.case-info-row {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}

.case-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  min-width: 60rpx;
}

.case-value {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex: 1;
  min-width: 0;
}

.case-highlight {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-xs);
  padding-top: var(--spacing-md);
  border-top: 1rpx dashed var(--color-border-light);
}

.case-offer-label {
  font-size: 22rpx;
  color: var(--color-accent);
  font-weight: 500;
  background: rgba(201, 169, 98, 0.1);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.case-offer-value {
  font-size: 24rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

/* ==================== 顾问列表 ==================== */
.consultant-scroll {
  white-space: nowrap;
  margin: 0 calc(-1 * var(--spacing-lg));
  padding: 0 var(--spacing-lg);
}

.consultant-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 220rpx;
  margin-right: 40rpx;
  padding: var(--spacing-md) 0;
  vertical-align: top;
  transition: transform var(--duration-normal) var(--ease-out);
}

.consultant-item:active {
  transform: scale(0.95);
}

.consultant-avatar-wrapper {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--spacing-sm);
}

.consultant-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid var(--color-bg-primary);
  box-shadow: var(--shadow-md);
}

.consultant-ring {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-accent);
  opacity: 0.5;
}

.consultant-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
}

.consultant-title {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.consultant-action {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.2);
}

.consultant-action-text {
  font-size: 22rpx;
  color: var(--color-text-white);
  font-weight: 500;
}

/* ==================== 浮动按钮 ==================== */
.fab {
  position: fixed;
  right: var(--spacing-lg);
  bottom: calc(var(--spacing-2xl) + env(safe-area-inset-bottom));
  z-index: 100;
}

.fab-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
  border-radius: 50%;
  box-shadow: var(--shadow-float);
  transition: all var(--duration-normal) var(--ease-out);
}

.fab-button:active {
  transform: scale(0.9);
}

.fab-icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) invert(1);
}

.fab-text {
  font-size: 20rpx;
  color: var(--color-text-white);
  font-weight: 500;
  margin-top: 2rpx;
}
