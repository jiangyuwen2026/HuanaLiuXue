<!-- 专业详情页 -->
<view class="container">
  <!-- 专业信息 -->
  <view class="major-info card">
    <view class="info-header">
      <text class="major-name">{{major.name}}</text>
      <text class="major-category tag tag-primary">{{major.category}}</text>
    </view>
    <text class="major-desc">{{major.description}}</text>
  </view>

  <!-- 专业介绍 -->
  <view class="section card">
    <view class="section-title">专业介绍</view>
    <text class="section-content">{{major.introduction}}</text>
  </view>

  <!-- 课程设置 -->
  <view class="section card">
    <view class="section-title">课程设置</view>
    <view class="course-list">
      <text class="course-item" wx:for="{{major.courses}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 开设院校 -->
  <view class="section card">
    <view class="section-title">开设院校</view>
    <view class="school-list">
      <view class="school-item" wx:for="{{major.schools}}" wx:key="id" bindtap="goToSchool" data-id="{{item.id}}">
        <text class="school-name">{{item.name}}</text>
        <text class="school-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 就业方向 -->
  <view class="section card">
    <view class="section-title">就业方向</view>
    <view class="career-list">
      <view class="career-item" wx:for="{{major.careers}}" wx:key="*this">
        <text class="career-name">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 录取要求 -->
  <view class="section card">
    <view class="section-title">录取要求</view>
    <view class="requirement-item">
      <text class="req-label">背景要求：</text>
      <text class="req-value">{{major.backgroundRequirement}}</text>
    </view>
    <view class="requirement-item">
      <text class="req-label">语言要求：</text>
      <text class="req-value">{{major.languageRequirement}}</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <button class="action-btn btn-outline" bindtap="toggleCollect">
      {{major.isCollected ? '已收藏' : '收藏专业'}}
    </button>
    <button class="action-btn" bindtap="makeAppointment">咨询该专业</button>
  </view>
</view>
