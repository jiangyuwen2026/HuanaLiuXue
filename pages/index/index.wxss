/* 首页样式 */

.container {
  padding: 0;
}

/* Banner */
.banner {
  height: 400rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 快捷入口 */
.quick-section {
  background: #fff;
  padding: 40rpx 30rpx;
  margin: 20rpx;
  border-radius: 16rpx;
}

.quick-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.quick-grid {
  display: flex;
  justify-content: space-between;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.quick-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.quick-name {
  font-size: 26rpx;
  color: #666;
}

/* 品牌介绍 */
.brand-section {
  background: linear-gradient(135deg, #2C5F7C 0%, #4A90A4 100%);
  margin: 20rpx;
  padding: 60rpx 40rpx;
  border-radius: 16rpx;
  text-align: center;
}

.brand-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.brand-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 40rpx;
}

.brand-stats {
  display: flex;
  justify-content: space-around;
}

.brand-stat {
  text-align: center;
}

.brand-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.brand-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}
