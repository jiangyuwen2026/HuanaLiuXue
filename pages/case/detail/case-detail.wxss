/* 案例详情页样式 */
.container {
  padding-bottom: 120rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #2C5F7C;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 首图区域 */
.cover-section {
  margin: -20rpx -20rpx 20rpx -20rpx;
  height: 400rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

/* 学生信息头部 */
.student-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin: 30rpx;
}

.student-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
}

.student-info {
  flex: 1;
}

.student-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.student-degree {
  display: inline-block;
}

.case-result {
  text-align: center;
}

.result-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.result-text {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
}

.text-success {
  color: #52c41a;
}

/* 通用卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section {
  padding: 30rpx;
  margin: 0 20rpx 20rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 录取结果卡片 */
.offer-card {
  background: linear-gradient(135deg, #f6ffed 0%, #fff 100%);
  border: 2rpx solid #b7eb8f;
  border-radius: 12rpx;
  padding: 30rpx;
}

.offer-school {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.offer-major {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.offer-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.tag-success {
  background-color: #f6ffed;
  color: #52c41a;
}

.tag-primary {
  background-color: #e6f7ff;
  color: #1890ff;
}

/* 申请背景 */
.background-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bg-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.bg-item:last-child {
  border-bottom: none;
}

.bg-label {
  font-size: 26rpx;
  color: #666;
}

.bg-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

/* 申请故事 */
.story-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #666;
  text-align: justify;
}

/* 申请材料 */
.material-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.material-item {
  font-size: 28rpx;
  color: #52c41a;
  line-height: 1.6;
}

/* 顾问点评 */
.consultant-review {
  padding: 24rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.reviewer-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.reviewer-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
  overflow: hidden;
  flex-shrink: 0;
}

.reviewer-avatar {
  width: 100%;
  height: 100%;
}

.reviewer-details {
  flex: 1;
}

.reviewer-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.reviewer-title {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.review-content {
  font-size: 26rpx;
  line-height: 1.8;
  color: #666;
}

/* 底部操作 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  padding: 0 10rpx;
}

.action-icon {
  font-size: 40rpx;
  color: #2C5F7C;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: none;
  background: linear-gradient(135deg, #2C5F7C 0%, #1e4155 100%);
  color: #fff;
  padding: 0;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.btn-outline {
  background: #fff;
  color: #2C5F7C;
  border: 2rpx solid #2C5F7C;
}

/* 分享按钮样式 */
.action-btn[open-type="share"] {
  background: #fff;
  color: #2C5F7C;
  border: 2rpx solid #2C5F7C;
}
