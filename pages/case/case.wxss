/* 案例页面样式 */

/* Featured 区域 */
.featured-section {
  background: #fff;
  padding: 32rpx 0;
  margin: -20rpx -20rpx 20rpx -20rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 20rpx;
}

.featured-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.featured-card {
  display: inline-block;
  width: 280rpx;
  height: 360rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
  vertical-align: top;
}

.featured-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 40rpx;
}

.featured-student {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 60rpx;
}

.featured-school {
  display: block;
  color: rgba(255, 255, 255, 0.95);
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.featured-major {
  display: block;
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 筛选栏 - 使用flex布局，无滚动条 */
.filter-section {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-item {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 32rpx;
  white-space: nowrap;
}

.filter-item.active {
  background: #2C5F7C;
  color: #fff;
}

/* 案例列表 */
.case-list {
  padding-bottom: 40rpx;
}

.case-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.case-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.case-student {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.case-result {
  font-size: 24rpx;
  color: #52c41a;
  background: rgba(82, 196, 26, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.case-body {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.case-info {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.case-offer {
  display: block;
  font-size: 28rpx;
  color: #2C5F7C;
  font-weight: 500;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #2C5F7C;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.load-more text,
.no-more text {
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #999;
}
