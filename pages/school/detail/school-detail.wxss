/* 学校详情页样式 */
.container {
  padding-bottom: 120rpx;
}

/* 学校头图 */
.school-cover {
  width: 100%;
  height: 400rpx;
}

/* 学校信息 */
.school-info {
  margin: -40rpx 30rpx 20rpx;
  position: relative;
  z-index: 1;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.school-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.school-ranking {
  padding: 6rpx 16rpx;
  background-color: #fff7e6;
  color: #faad14;
  font-size: 24rpx;
  border-radius: 4rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

/* 标签 */
.tags-section {
  margin: 0 30rpx 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.tag-primary {
  background-color: #e6f7ff;
  color: #1890ff;
}

.tag-success {
  background-color: #f6ffed;
  color: #52c41a;
}

/* 通用区块 */
.section {
  margin: 0 30rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #666;
}

/* ==================== 院系与专业 ==================== */
.faculty-section {
  margin-bottom: 30rpx;
}

.faculty-section:last-child {
  margin-bottom: 0;
}

.sub-section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.degree-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.degree-count {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-secondary);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

/* 院系列表 */
.faculty-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.faculty-item {
  background: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: all var(--duration-normal) var(--ease-out);
}

.faculty-item:active {
  transform: scale(0.98);
}

.faculty-header {
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-bg-primary);
  border-bottom: 1rpx solid transparent;
  transition: border-bottom var(--duration-normal);
}

.faculty-item.expanded .faculty-header {
  border-bottom: 1rpx solid var(--color-border-light);
}

.faculty-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.faculty-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.faculty-arrow {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  transition: transform var(--duration-normal);
}

.faculty-item.expanded .faculty-arrow {
  transform: rotate(90deg);
}

.major-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: rgba(30, 58, 95, 0.08);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

/* 专业网格 */
.major-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  padding: 20rpx;
  background: var(--color-bg-secondary);
}

.major-grid-item {
  display: flex;
}

.major-item-inner {
  flex: 1;
  padding: 16rpx;
  background: var(--color-bg-primary);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-light);
  text-align: center;
  transition: all var(--duration-normal) var(--ease-out);
}

.major-item-inner:active {
  background: var(--color-bg-hover);
  transform: translateY(-2rpx);
}

.major-name-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 硕士分类列表 */
.category-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.category-item {
  background: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.category-header {
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(90deg, rgba(30, 58, 95, 0.1), rgba(45, 90, 159, 0.05));
}

.category-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.program-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: rgba(30, 58, 95, 0.08);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

/* 专业列表 */
.program-grid {
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  gap: 12rpx;
  padding: 20rpx;
}

.program-item {
  display: flex;
}

.program-item-inner {
  flex: 1;
  padding: 20rpx;
  background: var(--color-bg-primary);
  border-radius: var(--radius-md);
  border-left: 4rpx solid var(--color-primary);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  transition: all var(--duration-normal) var(--ease-out);
}

.program-item-inner:active {
  background: var(--color-bg-hover);
  transform: translateX(4rpx);
}

.program-name-text {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.program-info {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
}

.program-duration {
  color: var(--color-text-tertiary);
}

.program-language {
  color: var(--color-primary);
  background: rgba(30, 58, 95, 0.1);
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
}

/* 录取要求 */
.requirement-item {
  margin-bottom: 16rpx;
}

.req-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.req-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  padding-left: 20rpx;
}

/* 费用 */
.fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.fee-item:last-child {
  border-bottom: none;
}

.fee-label {
  font-size: 28rpx;
  color: #666;
}

.fee-value {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 500;
}

/* ==================== 底部操作栏 ==================== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 16rpx var(--spacing-lg);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: var(--color-bg-primary);
  box-shadow: var(--shadow-top);
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-full);
  border: none;
  transition: all var(--duration-normal) var(--ease-out);
}

.btn-outline {
  color: var(--color-primary);
  background: var(--color-bg-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-outline:active {
  background: rgba(30, 58, 95, 0.08);
  transform: scale(0.98);
}

.action-btn:not(.btn-outline) {
  color: var(--color-text-white);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.25);
}

.action-btn:not(.btn-outline):active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(30, 58, 95, 0.25);
}
