/* 学校列表页样式 */
page {
  background-color: #e8f4ff;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* ==================== 搜索头部 ==================== */
.search-header {
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  padding: var(--spacing-lg);
  padding-top: var(--spacing-xl);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-text-white);
  border-radius: var(--radius-full);
  padding: var(--spacing-sm) var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.search-icon-placeholder {
  font-size: 32rpx;
  margin-right: var(--spacing-sm);
}

.search-input {
  flex: 1;
  height: 56rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.search-placeholder {
  color: var(--color-text-tertiary);
}

.search-btn {
  padding: var(--spacing-sm) var(--spacing-lg);
  background: var(--color-accent);
  color: var(--color-text-white);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-full);
}

/* ==================== 筛选栏 ==================== */
.filter-container {
  background: var(--color-text-white);
  padding: var(--spacing-md) 0;
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 var(--spacing-md);
}

.filter-item {
  display: inline-block;
  padding: var(--spacing-sm) var(--spacing-lg);
  margin-right: var(--spacing-sm);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-secondary);
  border-radius: var(--radius-full);
  transition: all var(--duration-normal);
}

.filter-item.active {
  background: var(--color-primary);
  color: var(--color-text-white);
}

/* ==================== 内容区域 ==================== */
.content-wrapper {
  padding: var(--spacing-md);
}

/* ==================== 学校卡片 ==================== */
.school-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.school-item {
  background: var(--color-text-white);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
  transition: all var(--duration-normal);
}

.school-item:active {
  transform: scale(0.98);
}

/* 学校头部 */
.school-header {
  margin-bottom: var(--spacing-md);
}

.school-name-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-sm);
}

.school-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
}

.school-ranking {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-md);
}

.ranking-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.ranking-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-white);
}

.school-badges {
  display: flex;
  gap: var(--spacing-sm);
}

.badge-country {
  font-size: 22rpx;
}

.badge-type {
  font-size: 22rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.tag-primary {
  background: rgba(44, 95, 124, 0.1);
  color: var(--color-primary);
}

.tag-neutral {
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
}

/* 学校信息 */
.school-info {
  margin-bottom: var(--spacing-md);
}

.info-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xs);
}

.info-icon {
  font-size: 24rpx;
}

.info-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* 学校标签 */
.school-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.school-tag {
  padding: var(--spacing-xs) var(--spacing-sm);
  background: rgba(139, 195, 74, 0.1);
  color: var(--color-success);
  font-size: 22rpx;
  border-radius: var(--radius-sm);
}

/* 学校底部 */
.school-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--color-border);
}

.major-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  overflow: hidden;
}

.major-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  white-space: nowrap;
}

.major-value {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  font-size: 32rpx;
}

/* ==================== 加载状态 ==================== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-2xl);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: var(--spacing-md);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

/* ==================== 加载更多 ==================== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

/* ==================== 空状态 ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  background: var(--color-bg-secondary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
}

.empty-icon-text {
  font-size: 80rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 浮动按钮 ==================== */
.fab {
  position: fixed;
  right: var(--spacing-lg);
  bottom: calc(var(--spacing-2xl) + env(safe-area-inset-bottom));
  z-index: 100;
}

.fab-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
  border-radius: 50%;
  box-shadow: var(--shadow-float);
  transition: all var(--duration-normal) var(--ease-out);
}

.fab-button:active {
  transform: scale(0.9);
}

.fab-icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) invert(1);
}

.fab-text {
  font-size: 20rpx;
  color: var(--color-text-white);
  font-weight: 500;
  margin-top: 2rpx;
}
