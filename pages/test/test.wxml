<!--pages/test/test.wxml-->
<view class="test-page">
  <!-- 标题栏 -->
  <view class="header">
    <text class="title">功能测试</text>
    <text class="subtitle">华南留学小程序测试工具</text>
  </view>

  <!-- 测试操作区 -->
  <view class="actions">
    <view class="action-item">
      <button 
        type="primary" 
        bindtap="runAllTests" 
        disabled="{{isRunning}}"
        loading="{{isRunning}}"
      >
        运行全部测试
      </button>
    </view>
    
    <view class="action-row">
      <button 
        type="default" 
        bindtap="runAPITests" 
        size="mini"
      >
        API测试
      </button>
      
      <button 
        type="default" 
        bindtap="runRuleEngineTests" 
        size="mini"
      >
        规则引擎
      </button>
      
      <button 
        type="default" 
        bindtap="runAITests" 
        size="mini"
      >
        AI服务
      </button>
    </view>

    <view class="action-row">
      <button 
        type="default" 
        bindtap="clearResults" 
        size="mini"
      >
        清除结果
      </button>
      
      <button 
        type="default" 
        bindtap="exportReport" 
        size="mini"
      >
        导出报告
      </button>
    </view>
  </view>

  <!-- 测试结果摘要 -->
  <view class="summary" wx:if="{{summary.total > 0}}">
    <view class="summary-item">
      <text class="label">总测试数</text>
      <text class="value">{{summary.total}}</text>
    </view>
    
    <view class="summary-item success">
      <text class="label">通过</text>
      <text class="value">{{summary.passed}}</text>
    </view>
    
    <view class="summary-item error">
      <text class="label">失败</text>
      <text class="value">{{summary.failed}}</text>
    </view>
    
    <view class="summary-item">
      <text class="label">通过率</text>
      <text class="value">{{summary.passRate}}%</text>
    </view>
  </view>

  <!-- 测试结果列表 -->
  <view class="results" wx:if="{{testResults && testResults.length > 0}}">
    <view class="result-title">测试结果</view>
    
    <view 
      class="result-item {{item.status === 'passed' ? 'success' : 'error'}}"
      wx:for="{{testResults}}"
      wx:key="name"
    >
      <view class="result-header">
        <text class="result-icon">{{item.status === 'passed' ? '✅' : '❌'}}</text>
        <text class="result-name">{{item.name}}</text>
        <text class="result-duration" wx:if="{{item.duration}}">{{item.duration}}</text>
      </view>
      
      <view class="result-error" wx:if="{{item.error}}">
        <text class="error-label">错误：</text>
        <text class="error-message">{{item.error}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!testResults && !isRunning}}">
    <image class="empty-icon" src="/images/empty.png" mode="aspectFit"></image>
    <text class="empty-text">点击按钮开始测试</text>
  </view>
</view>
