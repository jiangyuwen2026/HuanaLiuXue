<view class="container">
  
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">我的收藏</text>
  </view>

  <!-- 标签切换 -->
  <view class="tab-section">
    <view 
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      <text class="tab-text">{{item.label}}</text>
      <view class="tab-badge" wx:if="{{favorites[item.key].length > 0}}">
        {{favorites[item.key].length}}
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 收藏列表 -->
  <view class="content-section" wx:if="{{!loading}}">
    
    <!-- 院校收藏 -->
    <view class="favorite-list" wx:if="{{activeTab === 'school'}}">
      <view 
        class="favorite-card school-card" 
        wx:for="{{favorites.school}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
        data-type="school"
      >
        <image class="school-logo" src="{{item.logo || '/images/schools/default.png'}}" mode="aspectFill"></image>
        <view class="school-info">
          <text class="school-name">{{item.name}}</text>
          <text class="school-ranking">{{item.ranking}}</text>
          <text class="school-country">{{item.country}}</text>
        </view>
        <view class="action-wrap">
          <text class="cancel-btn" catchtap="cancelFavorite" data-id="{{item.id}}" data-type="school">取消收藏</text>
        </view>
      </view>
    </view>

    <!-- 案例收藏 -->
    <view class="favorite-list" wx:if="{{activeTab === 'case'}}">
      <view 
        class="favorite-card case-card" 
        wx:for="{{favorites.case}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
        data-type="case"
      >
        <view class="case-header">
          <text class="case-tag">{{item.highlight}}</text>
        </view>
        <view class="case-body">
          <text class="case-student">{{item.studentName}}</text>
          <text class="case-school">{{item.school}}</text>
          <text class="case-major">{{item.major}}</text>
        </view>
        <view class="action-wrap">
          <text class="cancel-btn" catchtap="cancelFavorite" data-id="{{item.id}}" data-type="case">取消收藏</text>
        </view>
      </view>
    </view>

    <!-- 资讯收藏 -->
    <view class="favorite-list" wx:if="{{activeTab === 'news'}}">
      <view 
        class="favorite-card news-card" 
        wx:for="{{favorites.news}}"
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
        data-type="news"
      >
        <view class="news-content">
          <text class="news-tag">{{item.category}}</text>
          <text class="news-title">{{item.title}}</text>
          <text class="news-time">{{item.publishTime}}</text>
        </view>
        <view class="action-wrap">
          <text class="cancel-btn" catchtap="cancelFavorite" data-id="{{item.id}}" data-type="news">取消收藏</text>
        </view>
      </view>
    </view>

  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && favorites[activeTab].length === 0}}">
    <view class="empty-icon">⭐</view>
    <text class="empty-title">暂无收藏</text>
    <text class="empty-desc">点击内容页面的收藏按钮，将感兴趣的内容保存到这里</text>
    <button class="btn-primary" bindtap="goToExplore">去发现</button>
  </view>

</view>
