/* 资讯页面样式 */

/* 标签样式 */
.tab-section {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.tab-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 32rpx;
}

.tab-item.active {
  color: #fff;
  background: #2C5F7C;
}

/* 资讯卡片 */
.news-list {
  padding-bottom: 40rpx;
}

.news-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.news-cover-wrapper {
  width: 100%;
  height: 320rpx;
  background: #f0f0f0;
}

.news-cover {
  width: 100%;
  height: 320rpx;
  display: block;
}

.news-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
}

.placeholder-icon {
  font-size: 60rpx;
  opacity: 0.5;
}

.news-content {
  padding: 24rpx;
}

.news-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.news-summary {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.news-meta {
  display: flex;
  align-items: center;
}

.news-tag {
  font-size: 22rpx;
  color: #2C5F7C;
  background: rgba(44, 95, 124, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.news-views {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}

.news-time {
  font-size: 24rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #2C5F7C;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.loading-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
}
