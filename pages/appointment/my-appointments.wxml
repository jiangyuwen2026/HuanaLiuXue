<view class="container">
  
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">我的预约</text>
    <text class="page-subtitle">查看和管理您的咨询预约</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 预约列表 -->
  <view class="appointment-list" wx:if="{{!loading && appointmentList.length > 0}}">
    <view 
      class="appointment-card" 
      wx:for="{{appointmentList}}" 
      wx:key="id"
    >
      <!-- 卡片头部 -->
      <view class="card-header">
        <view class="consultant-info">
          <image 
            class="consultant-avatar" 
            src="{{item.consultant_avatar || '/images/icon/consult2.png'}}" 
            mode="aspectFill"
          ></image>
          <view class="consultant-detail">
            <text class="consultant-name">{{item.consultant_name || '资深顾问'}}</text>
            <text class="consultant-title">{{item.consultant_title || '留学规划专家'}}</text>
          </view>
        </view>
        <view class="status-badge {{item.status}}">
          <text class="status-dot"></text>
          <text class="status-text">{{item.status_text || getStatusText(item.status)}}</text>
        </view>
      </view>

      <!-- 预约信息 -->
      <view class="card-body">
        <view class="info-row">
          <text class="info-icon">📅</text>
          <view class="info-content">
            <text class="info-label">预约日期</text>
            <text class="info-value">{{item.appointment_date}}</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-icon">⏰</text>
          <view class="info-content">
            <text class="info-label">预约时间</text>
            <text class="info-value">{{item.appointment_time}}</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-icon">📍</text>
          <view class="info-content">
            <text class="info-label">咨询方式</text>
            <text class="info-value">{{item.type === 'offline' ? '线下到访' : '在线咨询'}}</text>
          </view>
        </view>
        <view class="info-row" wx:if="{{item.remark}}">
          <text class="info-icon">📝</text>
          <view class="info-content">
            <text class="info-label">备注</text>
            <text class="info-value">{{item.remark}}</text>
          </view>
        </view>
      </view>

      <!-- 卡片底部操作 -->
      <view class="card-footer">
        <text class="create-time">创建于 {{item.created_at}}</text>
        <view class="action-btns">
          <button 
            wx:if="{{item.status === 'pending' || item.status === 'confirmed'}}" 
            class="btn btn-cancel" 
            bindtap="cancelAppointment" 
            data-id="{{item.id}}"
          >取消</button>
          <button 
            wx:if="{{item.status === 'completed'}}" 
            class="btn btn-primary" 
            bindtap="rebook"
          >再次预约</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && appointmentList.length === 0}}">
    <view class="empty-icon">📋</view>
    <text class="empty-title">暂无预约记录</text>
    <text class="empty-desc">您还没有预约任何咨询服务</text>
    <button class="btn-primary" bindtap="rebook">立即预约咨询</button>
  </view>

</view>
