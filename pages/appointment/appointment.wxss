/* 优化后的预约页面样式 */

page {
  background: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
}

.page-container {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #2C5F7C 0%, #4A90A4 100%);
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 内容区 */
.content-wrapper {
  margin-top: -40rpx;
  padding: 0 30rpx;
  position: relative;
  z-index: 1;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  background: #e0e0e0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #999;
  margin-bottom: 12rpx;
}

.step-item.active .step-num {
  background: #2C5F7C;
  color: #fff;
}

.step-text {
  font-size: 24rpx;
  color: #999;
}

.step-item.active .step-text {
  color: #2C5F7C;
  font-weight: 500;
}

.step-line {
  width: 80rpx;
  height: 2rpx;
  background: #e0e0e0;
  margin: 0 30rpx;
  margin-bottom: 30rpx;
}

/* 区块卡片 */
.section-block {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.title-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.title-required {
  color: #ff6b6b;
  margin-left: 8rpx;
  font-size: 28rpx;
}

.subsection-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: 500;
}

/* 加载中 */
.loading-consultants {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-spinner-small {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #2C5F7C;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text-small {
  font-size: 26rpx;
  color: #999;
}

/* 顾问列表 */
.consultant-scroll {
  white-space: nowrap;
  margin: 0 -16rpx;
}

.consultant-list {
  display: inline-flex;
  padding: 0 16rpx;
}

.consultant-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 220rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  margin-right: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
  text-align: center;
}

.consultant-card.selected {
  background: linear-gradient(135deg, rgba(44, 95, 124, 0.08) 0%, rgba(74, 144, 164, 0.08) 100%);
  border-color: #2C5F7C;
  box-shadow: 0 8rpx 24rpx rgba(44, 95, 124, 0.15);
}

.avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
}

.consultant-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.selected-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 40rpx;
  height: 40rpx;
  background: #2C5F7C;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
}

.badge-icon {
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
}

.consultant-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.consultant-title {
  font-size: 24rpx;
  color: #2C5F7C;
  margin-bottom: 12rpx;
}

.consultant-tags {
  margin-bottom: 12rpx;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #666;
  background: #e8e8e8;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.consultant-meta {
  display: flex;
  align-items: center;
}

.meta-item {
  font-size: 20rpx;
  color: #999;
}

.meta-dot {
  font-size: 20rpx;
  color: #ccc;
  margin: 0 8rpx;
}

/* 已选顾问提示条 */
.selected-consultant-bar {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(44, 95, 124, 0.06) 0%, rgba(74, 144, 164, 0.06) 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #2C5F7C;
}

.selected-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #2C5F7C;
}

.selected-info {
  flex: 1;
}

.selected-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #2C5F7C;
  margin-bottom: 4rpx;
}

.selected-title {
  display: block;
  font-size: 22rpx;
  color: #666;
}

/* 咨询类型 */
.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.type-grid.four-cols {
  grid-template-columns: repeat(2, 1fr);
}

.type-card {
  position: relative;
  padding: 24rpx 16rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  text-align: center;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.type-card.selected {
  background: linear-gradient(135deg, rgba(44, 95, 124, 0.08) 0%, rgba(74, 144, 164, 0.08) 100%);
  border-color: #2C5F7C;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.type-desc {
  display: block;
  font-size: 20rpx;
  color: #999;
}

.type-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  background: #2C5F7C;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
}

/* 日期选择 */
.date-section {
  margin-bottom: 32rpx;
}

.date-scroll {
  white-space: nowrap;
}

.date-list {
  display: inline-flex;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  padding: 20rpx 16rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-right: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.date-item.selected {
  background: #2C5F7C;
  box-shadow: 0 8rpx 24rpx rgba(44, 95, 124, 0.3);
}

.date-weekday {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.date-item.selected .date-weekday {
  color: rgba(255, 255, 255, 0.8);
}

.date-day {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.date-item.selected .date-day {
  color: #fff;
}

.date-month {
  font-size: 20rpx;
  color: #999;
}

.date-item.selected .date-month {
  color: rgba(255, 255, 255, 0.8);
}

/* 时间选择 */
.time-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.time-item {
  padding: 20rpx 12rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.time-item.selected {
  background: #2C5F7C;
  box-shadow: 0 4rpx 12rpx rgba(44, 95, 124, 0.3);
}

.time-item.disabled {
  opacity: 0.4;
  background: #e8e8e8;
}

.time-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.time-item.selected .time-text {
  color: #fff;
}

.time-status {
  display: block;
  font-size: 18rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 表单 */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.form-input:focus {
  border-color: #2C5F7C;
  background: #fff;
}

.form-textarea {
  height: 180rpx;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  border: 2rpx solid transparent;
  position: relative;
}

.char-count {
  position: absolute;
  right: 40rpx;
  bottom: 40rpx;
  font-size: 22rpx;
  color: #999;
}

/* 底部提交栏 */
.bottom-spacer {
  height: 140rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-section {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.price-value.free {
  color: #52c41a;
}

.price-value.type-name {
  font-size: 32rpx;
  color: #2C5F7C;
}

.submit-btn {
  min-width: 280rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #2C5F7C 0%, #4A90A4 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(44, 95, 124, 0.3);
}

.submit-btn.disabled {
  background: #ccc;
  box-shadow: none;
}

.submit-btn::after {
  border: none;
}
