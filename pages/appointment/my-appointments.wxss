/* 我的预约页面样式 */

.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #2C5F7C 0%, #1e4155 100%);
  padding: 60rpx 30rpx 80rpx;
  margin-bottom: -40rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #2C5F7C;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 预约列表 */
.appointment-list {
  padding: 0 30rpx;
}

.appointment-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.consultant-info {
  display: flex;
  align-items: center;
}

.consultant-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
}

.consultant-detail {
  display: flex;
  flex-direction: column;
}

.consultant-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.consultant-title {
  font-size: 24rpx;
  color: #999;
}

/* 状态标签 */
.status-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

/* 待确认 - 橙色 */
.status-badge.pending {
  background: #fff7e6;
  color: #fa8c16;
}
.status-badge.pending .status-dot {
  background: #fa8c16;
}

/* 已确认 - 蓝色 */
.status-badge.confirmed {
  background: #e6f7ff;
  color: #1890ff;
}
.status-badge.confirmed .status-dot {
  background: #1890ff;
}

/* 已完成 - 绿色 */
.status-badge.completed {
  background: #f6ffed;
  color: #52c41a;
}
.status-badge.completed .status-dot {
  background: #52c41a;
}

/* 已取消 - 灰色 */
.status-badge.cancelled {
  background: #f5f5f5;
  color: #999;
}
.status-badge.cancelled .status-dot {
  background: #999;
}

/* 卡片内容 */
.card-body {
  padding: 30rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  width: 40rpx;
  text-align: center;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fafafa;
  border-top: 1rpx solid #f5f5f5;
}

.create-time {
  font-size: 22rpx;
  color: #999;
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.btn {
  min-width: 140rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-radius: 28rpx;
  border: none;
  text-align: center;
}

.btn::after {
  border: none;
}

.btn-cancel {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.btn-primary {
  background: linear-gradient(135deg, #2C5F7C 0%, #1e4155 100%);
  color: #fff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-primary {
  width: 320rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2C5F7C 0%, #1e4155 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}
